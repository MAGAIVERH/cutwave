# App URL (required for chat tools and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon / PostgreSQL)
DATABASE_URL=

# Google Gemini — used by /api/chat (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional; default gemini-2.5-flash (2.0-flash free tier often has zero quota)
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (bookings checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
